# ============================================
# Ghidra-MCP-WSL-Auto 環境設定
# 複製此檔案為 .env 並填入您的設定
# 此檔案不應加入版本控制
# ============================================

# MCP 連接模式：cli | apikey | local
#   cli    → Claude Code CLI（Tier C，能力最強，需連線至雲端）
#   apikey → 直接使用 LLM API Key（Tier C）
#   local  → Ollama + 支援 SSE 的 MCP client（Tier A，完全離線）
MCP_MODE=cli

# LLM 設定（僅 apikey 模式需要）
LLM_PROVIDER=openai          # openai | anthropic | 自訂
LLM_API_KEY=                 # 您的 API Key

# 本地模型設定（僅 local 模式需要，不含任何金鑰）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:32b     # 建議 ≥14B；小模型的多步 tool calling 失敗率極高
# MIN_AGENTIC_MODEL_B=14     # 規模警告門檻（B 參數量）

# Ghidra 插件 HTTP Server port（預設 60005，避免常見 8080 衝突）
# Launcher 啟動時會自動 patch Ghidra tool config 設定此 port
GHIDRA_PLUGIN_PORT=60005

# MCP Bridge SSE Server port（Claude Code 連接端點）
MCP_SERVER_PORT=60006

# Ghidra 設定 (可選)
# GHIDRA_VERSION=11.3.1      # 指定安裝版本
# GHIDRA_XMX=4096            # JVM 最大記憶體 (MB)
